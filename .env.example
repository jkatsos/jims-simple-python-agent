# Copy to .env and fill in your own values. Never commit .env.
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENTO11Y_ENDPOINT=<your-grafana-agento11y-endpoint>
AGENTO11Y_PROTOCOL=<protocol>
AGENTO11Y_AUTH_MODE=<auth-mode>
AGENTO11Y_AUTH_TENANT_ID=<your-tenant-id>
AGENTO11Y_AUTH_TOKEN=<your-token>
OTEL_EXPORTER_OTLP_ENDPOINT=<your-otlp-endpoint>
OTEL_EXPORTER_OTLP_HEADERS=<your-otlp-headers>
